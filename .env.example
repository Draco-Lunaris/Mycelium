# Path to the OKF bundle directory the agent manages (the global store)
BUNDLE_ROOT=./sample-bundle

# Path to the directory holding independent topic "shelves" — each
# subdirectory containing an index.md is a self-contained OKF bundle the agent
# can target with shelf="<name>". Defaults to a "shelves/" dir sibling to
# BUNDLE_ROOT. Leave unset for the default; set to empty to disable shelves.
#SHELVES_ROOT=

# Path to the library "stacks": full book markdown, one copy per book under
# LIBRARY_ROOT/<book-slug>/<book-slug>.md (+ figures/ + meta.json). Book
# catalog concepts in shelves reference a passage via book://<slug>#<anchor>;
# the agent's read_passage tool fetches the section on demand. Defaults to a
# "library/" dir sibling to BUNDLE_ROOT. Separate from the OKF shelves.
#LIBRARY_ROOT=

# ── Primary model ──────────────────────────────────────────────────────
# Any OpenAI-compatible or Anthropic-compatible API endpoint.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_FORMAT=openai          # "openai" | "anthropic"
LLM_MODEL=                     # model id to request, e.g. "deepseek-chat" or "claude-sonnet-5"

# ── Fallback model (optional) ──────────────────────────────────────────
# Used when the primary model fails with a retryable error (timeout, 5xx).
# Leave LLM_FALLBACK_API_BASE_URL empty to disable fallback.
LLM_FALLBACK_API_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_FORMAT=openai
LLM_FALLBACK_MODEL=
# LLM_FALLBACK_ALLOW_FOR=query   # optional: restrict to read-only operations

# ── Legacy env vars (still work but deprecated) ─────────────────────────
# Prefer the LLM_API_* vars above. These are mapped automatically.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# LLAMACPP_BASE_URL=
# LLAMACPP_API_KEY=
# LOCAL_BASE_URL=
# LOCAL_API_KEY=

# Commit bundle changes to git after each mutation
GIT_AUTOCOMMIT=false

PORT=3800

# Optional: require "Authorization: Bearer <token>" on /mcp and /api.
# Unset = open (fine for localhost/LAN). Set this before exposing mycelium anywhere.
#AUTH_TOKEN=

# Query cache: repeated memory_query questions answer from cache until the
# bundle changes. QUERY_CACHE=false disables; QUERY_CACHE_TTL e.g. "1h" (default 24h).
#QUERY_CACHE=true
#QUERY_CACHE_TTL=24h

# Hot memory: recent writes + recent answers form a working set that queries
# check with one cheap tool-free LLM call before the full agent run.
#HOT_MEMORY=true
#HOT_MEMORY_TTL=1h

# Dreaming: autonomous memory consolidation on an interval (opt-in).
# Deterministic signals (orphans, broken links, likely duplicates, oversized
# concepts, recent activity) decide if there's anything to do — a healthy
# memory costs nothing.
#DREAM_INTERVAL=6h
#DREAM_INSIGHTS=true

# ── Auth gateway (Caddy) ───────────────────────────────────────────────
# For the gated deployment (docker-compose.caddy.yml), run:
#   bash deploy/setup-gateway.sh
# It generates the values below, writes them to .env (local, gitignored), and
# renders deploy/Caddyfile (also gitignored). Set them here ONLY to reuse
# existing credentials so re-running the script preserves them.
# MYCELIUM_API_KEY=     # bearer token for /mcp + /api (openssl rand -hex 24)
# UI_USER=echo          # Basic Auth username for the web UI
# UI_PASS=              # Basic Auth password (plaintext; bcrypt-hashed into Caddyfile)
